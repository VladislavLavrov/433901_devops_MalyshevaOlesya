@model IEnumerable<SlagComposition>
@{ViewData["Title"]="Составы шлака";}<div class="d-flex justify-content-between"><h1>Составы шлака</h1><a class="btn btn-primary" asp-action="Create">Добавить</a></div><form method="get" class="my-3 d-flex gap-2"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Поиск по названию"><button class="btn btn-outline-primary">Найти</button><a class="btn btn-outline-secondary" asp-action="Index">Сброс</a></form><table class="table table-striped"><thead><tr><th>Название</th><th>CaO</th><th>MgO</th><th>Al₂O₃</th><th>SiO₂</th><th>Сумма</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.CaO</td><td>@x.MgO</td><td>@x.Al2O3</td><td>@x.SiO2</td><td>@x.Total</td><td><a asp-action="Details" asp-route-id="@x.Id">Открыть</a> · <a asp-action="Edit" asp-route-id="@x.Id">Изменить</a> · <a asp-action="Delete" asp-route-id="@x.Id">Удалить</a></td></tr>}</tbody></table>
