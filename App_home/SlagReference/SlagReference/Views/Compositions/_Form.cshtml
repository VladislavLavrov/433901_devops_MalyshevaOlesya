@model SlagComposition
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="row">@foreach(var field in new[]{"CaO","MgO","Al2O3","SiO2"}){<div class="col-md-3 mb-3"><label class="form-label" for="@field">@field, %</label><input class="form-control" type="number" step="0.01" min="0" max="100" id="@field" name="@field" value="@Model.GetType().GetProperty(field)!.GetValue(Model)"></div>}</div>
<div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div><p class="text-muted">Сумма четырёх компонентов должна составлять 100%.</p>
