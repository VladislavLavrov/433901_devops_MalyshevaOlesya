@model SlagComposition
@{ViewData["Title"]="Сведения о составе";}<h1>@Model.Name</h1><dl class="row"><dt class="col-sm-3">CaO</dt><dd class="col-sm-9">@Model.CaO %</dd><dt class="col-sm-3">MgO</dt><dd class="col-sm-9">@Model.MgO %</dd><dt class="col-sm-3">Al₂O₃</dt><dd class="col-sm-9">@Model.Al2O3 %</dd><dt class="col-sm-3">SiO₂</dt><dd class="col-sm-9">@Model.SiO2 %</dd><dt class="col-sm-3">Сумма</dt><dd class="col-sm-9">@Model.Total %</dd><dt class="col-sm-3">Примечание</dt><dd class="col-sm-9">@Model.Notes</dd></dl><h3>Температурные характеристики</h3><table class="table"><tr><th>°C</th><th>Описание</th><th>Источник</th></tr>@foreach(var t in Model.Temperatures){<tr><td>@t.TemperatureC</td><td>@t.Description</td><td>@t.Source</td></tr>}</table><a asp-action="Index" class="btn btn-secondary">Назад</a>
